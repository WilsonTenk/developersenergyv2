# ----------------------------------------------------------------------
# Apache / cPanel configuration for The Developers Energy SPA
# ----------------------------------------------------------------------

Options -Indexes

# Block repository, environment and build configuration files if copied to hosting.
<FilesMatch "(?i)^(\..*|package(-lock)?\.json|bun\.lock|.*\.(?:bak|sql|log|map|pem|key))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=86400" env=HTTPS
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep ACME certificate verification available; deny other hidden paths.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule ^(?:src|lib|node_modules)(?:/|$) - [F,L,NC]

  # Production cPanel serves TLS directly. Verify this rule if adding a TLS proxy.
  # Redirect before any internal rewrite so clean URLs are covered too. When the
  # repo root .htaccess routes requests in here, it has already redirected.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://thedevelopersenergy.com%{REQUEST_URI} [R=301,L]

  # Serve build-generated metadata without redirecting clean URLs.
  RewriteRule ^(about|services|insights|blog|training|contact)/?$ $1.html [L]
  RewriteRule ^blog/crude-oil-volatility/?$ blog/crude-oil-volatility.html [L]

  # Don't rewrite files or directories that exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Ensure proper MIME types for modern JS modules and assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Caching headers for optimal performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
