# ----------------------------------------------------------------------
# Root Apache / cPanel configuration for The Developers Energy
# ----------------------------------------------------------------------
# Used when the whole repository sits in public_html (cPanel Git Version
# Control clones it there). Every request is served from the built dist/
# folder; dist/.htaccess then handles SPA routing back to dist/index.html.

DirectoryIndex index.html

<FilesMatch "(?i)^(\..*|package(-lock)?\.json|bun\.lock|.*\.(?:bak|sql|log|map|pem|key|tsx?|ya?ml))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep ACME certificate verification available; deny other hidden paths.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

  # Canonical host over HTTPS. This must run here, before the dist/ rewrite,
  # or REQUEST_URI in dist/.htaccess would already carry the /dist/ prefix.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://thedevelopersenergy.com%{REQUEST_URI} [R=301,L]

  # Never expose source code, build config or package manifests
  RewriteRule ^(?:src|lib|node_modules|scripts|tests|docs)(?:/|$) - [F,L,NC]
  RewriteRule ^(package(-lock)?\.json|bun\.lock|tsconfig\.json|vite\.config\.ts|metadata\.json|README\.md|\.env.*|\.cpanel\.yml|\.gitignore)$ - [F,L]

  # Send everything (including the homepage "/") into dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

# Ensure proper MIME types for modern JS modules and assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
